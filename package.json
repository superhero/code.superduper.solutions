{
  "name": "@superhero/code.superduper.solutions",
  "version": "0.0.0",
  "description": "A browser-local Svelte and CodeMirror editor with IndexedDB repositories and Git-backed editing history.",
  "private": true,
  "type": "module",
  "scripts": {
    "badges:coverage": "bash .github/scripts/generate-coverage-badge.sh tmp/test/coverage/coverage-summary.json .github/badges",
    "badges:dependencies": "bash .github/scripts/generate-dependency-badges.sh package.json .github/badges",
    "badges:scenarios": "bash .github/scripts/generate-scenario-badge.sh .github/badges tmp/test/cucumber-source.json tmp/test/cucumber-test.json tmp/test/cucumber-automation.json tmp/test/cucumber-browser.json tmp/test/cucumber-speech.json",
    "build": "npm run icons:check && vite build",
    "icons:generate": "node build/favicons.mjs",
    "icons:check": "node build/favicons.mjs --check",
    "check": "npm run typecheck && npm test && npm run report:tests && npm run report:coverage && npm run badges:dependencies -- --check && npm run badges:scenarios -- --check && npm run badges:coverage -- --check",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "report:coverage": "node .github/scripts/generate-coverage-report.mjs tmp/test-coverage.html tmp/test/coverage",
    "report:tests": "node .github/scripts/generate-test-report.mjs tmp/test-report.html tmp/test/cucumber-source.json tmp/test/cucumber-test.json tmp/test/cucumber-automation.json tmp/test/cucumber-browser.json tmp/test/cucumber-speech.json",
    "test": "npm run test:speech && npm run test:source:coverage && npm run test:coverage && npm run build && npm run test:acceptance && npm run test:automation && npm run test:browser",
    "test:acceptance": "node --eval \"import('node:fs').then(({mkdirSync}) => mkdirSync('tmp/test', { recursive: true }))\" && cucumber-js --config cucumber.config.mjs --profile acceptance",
    "test:acceptance:coverage": "c8 --reporter=none npm --loglevel=error run test:acceptance",
    "test:automation": "cucumber-js --config cucumber.config.mjs --profile automation",
    "test:browser": "bash .github/scripts/test-browser.sh",
    "test:coverage": "c8 report --check-coverage",
    "test:source": "cucumber-js --config cucumber.config.mjs --profile source",
    "test:source:coverage": "c8 --reporter=none npm --loglevel=error run test:source",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test:speech": "node build/test-speech.mjs",
    "test:speech:live": "SPEECH_LIVE=1 node build/test-speech.mjs",
    "models:generate": "node build/model-runtimes.mjs --generate",
    "test:models": "vitest run --config vitest.models.config.mjs"
  },
